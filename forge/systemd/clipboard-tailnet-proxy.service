[Unit]
Description=Expose forge clipboard (127.0.0.1:3053) on the tailnet (100.108.178.13:3053) for beelink cloudflared ingress clip.jeffreykeyser.net
After=network-online.target tailscaled.service dev-inbox-clipboard.service

[Service]
ExecStart=/usr/bin/socat TCP-LISTEN:3053,fork,reuseaddr,bind=100.108.178.13 TCP:127.0.0.1:3053
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
